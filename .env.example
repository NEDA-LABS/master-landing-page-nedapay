# ── Supabase (Articles / CMS) ──────────────────────────────────
# Create a free project at https://supabase.com, then Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, never expose to the browser.
# Used by admin actions to write articles and upload images (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
